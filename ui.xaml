<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <NavigationView x:Name="nav" PaneDisplayMode="Left" IsSettingsVisible="False"
                    OpenPaneLength="176" CompactModeThresholdWidth="0">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="nav_data" Content="数据输入" Icon="Home" IsSelected="True"/>
        <NavigationViewItem x:Name="nav_axes" Content="坐标轴" Icon="ViewAll"/>
        <NavigationViewItem x:Name="nav_style" Content="曲线样式" Icon="Edit"/>
        <NavigationViewItem x:Name="nav_fit" Content="外推拟合" Icon="Calculator"/>
        <NavigationViewItem x:Name="nav_output" Content="导出保存" Icon="Save"/>
      </NavigationView.MenuItems>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="420"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左：参数设置 ==================== -->
        <ScrollViewer Grid.Column="0" Padding="14" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">

            <!-- ---------- 页 1：数据输入 ---------- -->
            <StackPanel x:Name="page_data" Spacing="12">
              <TextBlock Text="数据输入" FontSize="22" FontWeight="SemiBold"/>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="数据序列（最多 6 组）" FontSize="15" FontWeight="SemiBold"/>
                  <ComboBox x:Name="series_combo" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="序列 1"/><ComboBoxItem Content="序列 2"/>
                    <ComboBoxItem Content="序列 3"/><ComboBoxItem Content="序列 4"/>
                    <ComboBoxItem Content="序列 5"/><ComboBoxItem Content="序列 6"/>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="btn_add_series" Content="＋ 新建序列"/>
                    <Button x:Name="btn_del_series" Content="清空当前"/>
                    <Button x:Name="btn_demo" Content="载入示例"/>
                  </StackPanel>
                  <TextBox x:Name="series_name" Header="序列名称（用于图例）" Text="降温段 T-t 数据"/>
                  <TextBox x:Name="data_text" Header="X / Y 数据（可直接从 Excel 粘贴两列）"
                           PlaceholderText="0  298.15&#x0a;30  298.42&#x0a;60  298.88&#x0a;（Tab / 空格 / 逗号分隔，只给一列时 X 自动取 1,2,3...）"
                           AcceptsReturn="True" TextWrapping="NoWrap" Height="230"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           VerticalContentAlignment="Top"/>
                  <TextBlock x:Name="data_status" Text="尚未输入数据" Opacity="0.7"/>
                </StackPanel>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="从文件载入" FontSize="15" FontWeight="SemiBold"/>
                  <TextBox x:Name="csv_path" Header="CSV / TXT 绝对路径（可留空）" PlaceholderText="D:\data\calorimetry.csv"/>
                  <Button x:Name="btn_load_csv" Content="载入到当前序列"/>
                  <TextBlock Text="外推法作图典型用法：把升温段 / 降温段分别做线性拟合，将拟合线反向延长到指定时刻，读出修正后的温度。到「外推拟合」页设置即可。"
                             TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ---------- 页 2：坐标轴 ---------- -->
            <StackPanel x:Name="page_axes" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="坐标轴" FontSize="22" FontWeight="SemiBold"/>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="标题文字" FontSize="15" FontWeight="SemiBold"/>
                  <TextBox x:Name="title" Header="图标题"/>
                  <TextBox x:Name="xlabel" Header="X 轴标签"/>
                  <TextBox x:Name="ylabel" Header="Y 轴标签"/>
                </StackPanel>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="范围与刻度（留空 = 自动）" FontSize="15" FontWeight="SemiBold"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,6,0">
                      <NumberBox x:Name="xmin" Header="X 最小" HorizontalAlignment="Stretch"/>
                      <NumberBox x:Name="xmax" Header="X 最大" HorizontalAlignment="Stretch"/>
                      <NumberBox x:Name="xstep" Header="X 主刻度间隔" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" Margin="6,0,0,0">
                      <NumberBox x:Name="ymin" Header="Y 最小" HorizontalAlignment="Stretch"/>
                      <NumberBox x:Name="ymax" Header="Y 最大" HorizontalAlignment="Stretch"/>
                      <NumberBox x:Name="ystep" Header="Y 主刻度间隔" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </Grid>
                  <NumberBox x:Name="minor" Header="次刻度细分份数（0 = 关闭）" Minimum="0" Maximum="10" Value="0"/>
                </StackPanel>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="网格与边框" FontSize="15" FontWeight="SemiBold"/>
                  <CheckBox x:Name="grid_major" Content="显示主网格" IsChecked="True"/>
                  <CheckBox x:Name="grid_minor" Content="显示次网格"/>
                  <ComboBox x:Name="grid_style" Header="网格线型" SelectedIndex="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="实线"/><ComboBoxItem Content="虚线"/>
                    <ComboBoxItem Content="点线"/><ComboBoxItem Content="点划线"/>
                  </ComboBox>
                  <Slider x:Name="grid_alpha" Header="网格透明度" Minimum="0" Maximum="1"
                          StepFrequency="0.05" Value="0.45"/>
                  <CheckBox x:Name="ticks_in" Content="刻度线朝内"/>
                  <CheckBox x:Name="show_top_right" Content="显示上 / 右边框" IsChecked="True"/>
                  <NumberBox x:Name="spine_width" Header="边框线宽" Minimum="0" Maximum="5" Value="1"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ---------- 页 3：曲线样式 ---------- -->
            <StackPanel x:Name="page_style" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="曲线样式" FontSize="22" FontWeight="SemiBold"/>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="当前序列的线条与标记" FontSize="15" FontWeight="SemiBold"/>
                  <ComboBox x:Name="style_marker" Header="数据点标记" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="圆点"/><ComboBoxItem Content="方块"/>
                    <ComboBoxItem Content="上三角"/><ComboBoxItem Content="菱形"/>
                    <ComboBoxItem Content="十字"/><ComboBoxItem Content="无标记"/>
                  </ComboBox>
                  <NumberBox x:Name="style_msize" Header="标记大小" Minimum="1" Maximum="20" Value="5"/>
                  <ComboBox x:Name="style_linestyle" Header="连线线型" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="实线"/><ComboBoxItem Content="虚线"/>
                    <ComboBoxItem Content="点划线"/><ComboBoxItem Content="点线"/>
                    <ComboBoxItem Content="无线（只画散点）"/>
                  </ComboBox>
                  <NumberBox x:Name="style_lwidth" Header="线宽" Minimum="0.2" Maximum="8" Value="1.6"/>
                  <ComboBox x:Name="style_color" Header="曲线颜色" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="蓝 #2E86DE"/><ComboBoxItem Content="红 #E5484D"/>
                    <ComboBoxItem Content="绿 #30A46C"/><ComboBoxItem Content="橙 #F76B15"/>
                    <ComboBoxItem Content="紫 #8E4EC6"/><ComboBoxItem Content="青 #0091A7"/>
                  </ComboBox>
                  <CheckBox x:Name="style_errorbar" Content="显示 Y 误差棒"/>
                  <TextBox x:Name="style_error" Header="误差值（常数，或与该序列等长的一列数值）" PlaceholderText="0.02"/>
                </StackPanel>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="画布与图例" FontSize="15" FontWeight="SemiBold"/>
                  <ComboBox x:Name="style_font" Header="字体（论文常用宋体 + Times）" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="微软雅黑"/>
                    <ComboBoxItem Content="宋体 + Times New Roman"/>
                    <ComboBoxItem Content="黑体 + Times New Roman"/>
                    <ComboBoxItem Content="Times New Roman（纯英文）"/>
                    <ComboBoxItem Content="DejaVu Sans（纯英文）"/>
                  </ComboBox>
                  <NumberBox x:Name="font_size" Header="刻度 / 标签字号" Minimum="6" Maximum="28" Value="12"/>
                  <NumberBox x:Name="title_size" Header="标题字号" Minimum="8" Maximum="32" Value="15"/>
                  <NumberBox x:Name="width_in" Header="图宽（英寸）" Minimum="3" Maximum="20" Value="8"/>
                  <NumberBox x:Name="height_in" Header="图高（英寸）" Minimum="2" Maximum="16" Value="5.2"/>
                  <NumberBox x:Name="dpi" Header="预览 / 导出 DPI" Minimum="60" Maximum="600" Value="130"/>
                  <CheckBox x:Name="show_legend" Content="显示图例" IsChecked="True"/>
                  <ComboBox x:Name="legend_pos" Header="图例位置" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="自动"/><ComboBoxItem Content="右上"/>
                    <ComboBoxItem Content="左上"/><ComboBoxItem Content="右下"/>
                    <ComboBoxItem Content="左下"/><ComboBoxItem Content="图外右侧"/>
                  </ComboBox>
                  <CheckBox x:Name="transparent" Content="透明背景"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ---------- 页 4：外推拟合 ---------- -->
            <StackPanel x:Name="page_fit" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="外推拟合" FontSize="22" FontWeight="SemiBold"/>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <CheckBox x:Name="fitA_enabled" Content="启用拟合段 A" IsChecked="True"/>
                  <TextBox x:Name="fitA_label" Header="名称" Text="拟合 A"/>
                  <ComboBox x:Name="fitA_series" Header="对哪组数据拟合" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="序列 1"/><ComboBoxItem Content="序列 2"/>
                    <ComboBoxItem Content="序列 3"/><ComboBoxItem Content="序列 4"/>
                    <ComboBoxItem Content="序列 5"/><ComboBoxItem Content="序列 6"/>
                  </ComboBox>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="fitA_from" Grid.Column="0" Header="拟合起点 x（空=自动）" Margin="0,0,6,0"/>
                    <NumberBox x:Name="fitA_to" Grid.Column="1" Header="拟合终点 x（空=自动）" Margin="6,0,0,0"/>
                  </Grid>
                  <NumberBox x:Name="fitA_extrap" Header="外推到 x =（空 = 不外推，填 0 即外推到 t=0）"/>
                  <ComboBox x:Name="fitA_linestyle" Header="拟合线线型" SelectedIndex="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="实线"/><ComboBoxItem Content="虚线"/>
                    <ComboBoxItem Content="点划线"/><ComboBoxItem Content="点线"/>
                  </ComboBox>
                  <CheckBox x:Name="fitA_equation" Content="图上显示方程与 R²" IsChecked="True"/>
                  <CheckBox x:Name="fitA_point" Content="标注外推点坐标" IsChecked="True"/>
                </StackPanel>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <CheckBox x:Name="fitB_enabled" Content="启用拟合段 B"/>
                  <TextBox x:Name="fitB_label" Header="名称" Text="拟合 B"/>
                  <ComboBox x:Name="fitB_series" Header="对哪组数据拟合" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="序列 1"/><ComboBoxItem Content="序列 2"/>
                    <ComboBoxItem Content="序列 3"/><ComboBoxItem Content="序列 4"/>
                    <ComboBoxItem Content="序列 5"/><ComboBoxItem Content="序列 6"/>
                  </ComboBox>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="fitB_from" Grid.Column="0" Header="拟合起点 x（空=自动）" Margin="0,0,6,0"/>
                    <NumberBox x:Name="fitB_to" Grid.Column="1" Header="拟合终点 x（空=自动）" Margin="6,0,0,0"/>
                  </Grid>
                  <NumberBox x:Name="fitB_extrap" Header="外推到 x =（空 = 不外推）"/>
                  <ComboBox x:Name="fitB_linestyle" Header="拟合线线型" SelectedIndex="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="实线"/><ComboBoxItem Content="虚线"/>
                    <ComboBoxItem Content="点划线"/><ComboBoxItem Content="点线"/>
                  </ComboBox>
                  <CheckBox x:Name="fitB_equation" Content="图上显示方程与 R²" IsChecked="True"/>
                  <CheckBox x:Name="fitB_point" Content="标注外推点坐标" IsChecked="True"/>
                </StackPanel>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="结果选项" FontSize="15" FontWeight="SemiBold"/>
                  <CheckBox x:Name="show_x_intercept" Content="计算并显示 y = 0 处的 x 截距"/>
                  <CheckBox x:Name="show_delta" Content="报告两段外推点的差值 Δy" IsChecked="True"/>
                  <TextBlock Text="提示：拟合区间留空 = 用整组数据；若要只对降温段拟合，在「拟合起点 / 终点 x」里填该段的 x 范围。"
                             TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ---------- 页 5：导出保存 ---------- -->
            <StackPanel x:Name="page_output" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="导出保存" FontSize="22" FontWeight="SemiBold"/>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="图片导出" FontSize="15" FontWeight="SemiBold"/>
                  <TextBox x:Name="out_dir" Header="输出目录"/>
                  <TextBox x:Name="out_name" Header="文件名（不含扩展名）" Text="外推法作图"/>
                  <ComboBox x:Name="out_dpi" Header="导出 DPI" SelectedIndex="2" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="130（屏幕）"/><ComboBoxItem Content="200"/>
                    <ComboBoxItem Content="300（报告推荐）"/><ComboBoxItem Content="600（期刊）"/>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="btn_export_png" Content="导出 PNG" Style="{ThemeResource AccentButtonStyle}"/>
                    <Button x:Name="btn_export_svg" Content="导出 SVG"/>
                    <Button x:Name="btn_export_pdf" Content="导出 PDF"/>
                  </StackPanel>
                  <Button x:Name="btn_export_txt" Content="导出数据与拟合结果 (TXT)"/>
                  <Button x:Name="btn_open_dir" Content="打开输出目录"/>
                </StackPanel>
              </Border>
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="工程文件（保存全部数据与设置）" FontSize="15" FontWeight="SemiBold"/>
                  <TextBox x:Name="project_path" Header="工程文件绝对路径 (.json)"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="btn_save_project" Content="保存工程"/>
                    <Button x:Name="btn_load_project" Content="载入工程"/>
                  </StackPanel>
                  <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                             Text="工程文件是 JSON，包含 6 组数据的原文、坐标轴 / 样式 / 外推的全部设置，方便下次接着调。"/>
                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ==================== 右：预览与结果 ==================== -->
        <Grid Grid.Column="1" Margin="4,14,16,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ToggleSwitch x:Name="auto_preview" Grid.Column="0" Header="实时预览" IsOn="True" Margin="0,0,8,0"/>
            <Button x:Name="btn_refresh" Grid.Column="1" Content="立即刷新预览" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="status" Grid.Column="2" Text="就绪" VerticalAlignment="Center"
                       TextWrapping="Wrap" Opacity="0.75"/>
          </Grid>

          <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="10"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image x:Name="preview" Stretch="None"/>
            </Viewbox>
          </Border>

          <Border Grid.Row="2" Margin="0,10,0,0" MinHeight="150" MaxHeight="230"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="result_text" IsTextSelectionEnabled="True" Text="拟合结果"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
